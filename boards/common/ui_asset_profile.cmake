# Resource size is independent of the board and display geometry.
set(XTOUCH_ASSET_SIZE "auto" CACHE STRING "UI resources: auto, small, large")
set_property(CACHE XTOUCH_ASSET_SIZE PROPERTY STRINGS auto small large)
if(XTOUCH_ASSET_SIZE STREQUAL "auto")
 if(XTOUCH_DISPLAY_WIDTH GREATER_EQUAL 480 AND XTOUCH_DISPLAY_HEIGHT GREATER_EQUAL 320 OR XTOUCH_BOARD MATCHES "[Pp]4" OR XTOUCH_PREVIEW_P4)
  set(XTOUCH_UI_HIDPI_ASSETS ON)
 else()
  set(XTOUCH_UI_HIDPI_ASSETS OFF)
 endif()
elseif(XTOUCH_ASSET_SIZE STREQUAL "large")
 set(XTOUCH_UI_HIDPI_ASSETS ON)
elseif(XTOUCH_ASSET_SIZE STREQUAL "small")
 set(XTOUCH_UI_HIDPI_ASSETS OFF)
else()
 message(FATAL_ERROR "XTOUCH_ASSET_SIZE must be auto, small or large")
endif()
