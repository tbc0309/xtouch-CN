# Shared by ESP-IDF firmware and native LVGL previews.
function(xtouch_ui_build_options TARGET)
# Port geometry is selected once; pages use shared design units.
if(XTOUCH_DISPLAY_WIDTH AND XTOUCH_DISPLAY_HEIGHT)
 target_compile_definitions(${TARGET} PUBLIC XTOUCH_DISPLAY_WIDTH=${XTOUCH_DISPLAY_WIDTH} XTOUCH_DISPLAY_HEIGHT=${XTOUCH_DISPLAY_HEIGHT})
endif()
set(XTOUCH_ICON_SET "" CACHE STRING "Icon family: original or mdi; empty selects screen default")
if(NOT XTOUCH_ICON_SET)
 if(XTOUCH_UI_HIDPI_ASSETS)
  set(XTOUCH_ICON_SET "mdi")
 else()
  set(XTOUCH_ICON_SET "original")
 endif()
endif()
if(XTOUCH_ICON_SET)
 if(NOT XTOUCH_ICON_SET MATCHES "^(original|mdi)$")
  message(FATAL_ERROR "XTOUCH_ICON_SET must be original or mdi")
 endif()
 if(XTOUCH_ICON_SET STREQUAL "mdi")
  target_compile_definitions(${TARGET} PUBLIC XTOUCH_ICON_STYLE=1)
 else()
  target_compile_definitions(${TARGET} PUBLIC XTOUCH_ICON_STYLE=0)
 endif()
 if(XTOUCH_UI_HIDPI_ASSETS)
  if(XTOUCH_ICON_SET STREQUAL "original")
   get_target_property(SELECTED ${TARGET} SOURCES)
   list(FILTER SELECTED EXCLUDE REGEX "/generated/large/ui_font_(xlcd|xlcdmin|actions|xperiments).c$")
   file(GLOB SELECTED_ICONS "${ROOT}/resources/ui-assets/generated/original/large/*.c")
   set_property(TARGET ${TARGET} PROPERTY SOURCES ${SELECTED} ${SELECTED_ICONS})
  endif()
 elseif(XTOUCH_ICON_SET STREQUAL "mdi")
  get_target_property(SELECTED ${TARGET} SOURCES)
  list(FILTER SELECTED EXCLUDE REGEX "/fonts/ui_font_(xlcd|xlcdmin).c$")
  file(GLOB SELECTED_ICONS "${ROOT}/resources/ui-assets/generated/mdi/small/*.c")
  set_property(TARGET ${TARGET} PROPERTY SOURCES ${SELECTED} ${SELECTED_ICONS})
 endif()
endif()

endfunction()
